# Copy to .env. All values have sane defaults in config.py — override only what you need.

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Reasoning model (the agent brain). Pull: ollama pull qwen3:8b
SESSION_MODEL=qwen3:8b

# Embeddings for Mem0/pgvector (768-dim). Pull: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text

# pgvector (matches docker-compose.yml)
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DB=mem0db
PGVECTOR_USER=mem0user
PGVECTOR_PASSWORD=mem0pass

# Stable agent identity — Session A and Session B must share this to share memory
AGENT_ID=compliance-agent-v1

# Optional: Langfuse tracing (provenance trace ids). Leave unset to auto-generate.
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=http://localhost:3000
