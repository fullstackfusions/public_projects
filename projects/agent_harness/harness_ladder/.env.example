# Copy to .env and fill in your values

# Frontier model (Run A)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (Run A + Run B weak model)
# Make sure Ollama is running: `ollama serve`
# Pull the weak model: `ollama pull qwen3:8b`
OLLAMA_BASE_URL=http://localhost:11434

# Optional: LangSmith tracing (recommended — traces become the audit artifact)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=harness-ladder
