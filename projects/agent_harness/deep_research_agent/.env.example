# Copy to .env. The default setup needs NO keys:
#   - model:  qwen3:8b via local Ollama (must be a tool-capable model — gemma3 is NOT)
#   - search: DuckDuckGo (ddgs), no key
#
# This file is only needed if you switch to a cloud model.

# Uncomment to use Claude instead of a local model (e.g. --model claude-opus-4-8):
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: point at a non-default Ollama host (defaults to http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434
