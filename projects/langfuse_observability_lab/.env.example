# --- Langfuse ---
# Free options for the hands-on:
#   1) Langfuse Cloud (fastest): https://cloud.langfuse.com -> New project -> Settings -> API Keys
#   2) Self-hosted: see "Self-hosting Langfuse" in README.md, then point LANGFUSE_HOST at it
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# --- LLM provider ---
# ollama (default, free, local) or openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
