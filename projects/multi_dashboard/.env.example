# Root .env.example — copy to .env and fill in secrets before running.
# Never commit the filled-in .env file.
#
# Each service also has its own backends/<service>/.env.example with per-service
# documentation. This file documents the variables that docker-compose.yml reads
# at the compose level (i.e. those referenced as ${VAR} in docker-compose.yml).

# ── Shared JWT secret (ALL backends must share the same value) ────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=dev-secret-key-change-in-production-abc123xyz

# ── Google OAuth 2.0 (auth-backend only) ─────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Callback URL registered in Google Cloud Console (must match exactly).
GOOGLE_REDIRECT_URI=http://localhost:8005/auth/google/callback

# Frontend URL where auth-py delivers tokens in the hash fragment.
FRONTEND_REDIRECT_URI=http://localhost:5173/auth/callback

# ── auth-backend database ─────────────────────────────────────────────────────
AUTH_DATABASE_URL=postgresql+asyncpg://auth:auth@localhost:5432/users_db

# ── scheduler-backend database ────────────────────────────────────────────────
SCHEDULER_DATABASE_URL=postgresql+asyncpg://scheduler:scheduler@localhost:5432/scheduler_db

# ── LLM providers (agentic-chat-backend) ─────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key


# Domain Configuration
DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# Traefik Dashboard Auth (generate with: htpasswd -nb admin yourpassword)
# Example: admin:$apr1$xyz...
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xyz$$hashedpassword

# JWT/Auth Secrets (generate with: openssl rand -hex 32)
AUTH_SECRET_KEY=your-32-character-secret-key-here-change-me
JWT_SECRET=your-jwt-secret-key-here-change-me

# Redis Configuration (optional)
REDIS_PASSWORD=

# Database Encryption (optional, for future use)
DB_ENCRYPTION_KEY=

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_CACHING=true
