# todo-go service — every env var the service reads.
# Copy to .env or set via docker-compose for local development.

# ---- shared (consumed by shared-go config.BaseSettings) ----------------------
SERVICE_NAME=todo-backend
ENVIRONMENT=development
LOG_LEVEL=info

# Comma-separated allowlist. NEVER `*` when AllowCredentials is true (CWE-942).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Shared HS256 secret. Every backend uses this to verify JWTs locally —
# no runtime call to auth-backend (service isolation principle, plan §2).
AUTH_SECRET_KEY=dev-secret-key-change-in-production-abc123xyz
AUTH_ALGORITHM=HS256

# ---- todo-go specific --------------------------------------------------------
PORT=8080
DATABASE_URL=postgres://todo:todo@localhost:5432/todo_db?sslmode=disable
