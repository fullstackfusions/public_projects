SERVICE_NAME=auth-backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
AUTH_DATABASE_URL=postgresql+asyncpg://auth:auth@postgres:5432/users_db

# JWT — shared with all other backends
AUTH_SECRET_KEY=dev-secret-key-change-in-production-abc123xyz
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8005/auth/google/callback

# Frontend redirect after OAuth (hash fragment delivery)
FRONTEND_REDIRECT_URI=http://localhost:5173/auth/callback

# Redis for OAuth state store
REDIS_URL=redis://redis:6379/1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seed users (comma-separated: username:password:role:email)
SEED_USERS=admin:admin123:admin:admin@example.com,demo:demo123:user:demo@example.com,user:user123:user:user@example.com
