# Scheduler Backend — Environment Variables
#
# Copy to .env for local development. Never commit the filled-in .env file.

# ── Service identity ──────────────────────────────────────────────────────────
SERVICE_NAME=scheduler-backend
ENVIRONMENT=development          # development | staging | production | test

# ── Database ──────────────────────────────────────────────────────────────────
# Use postgresql+asyncpg:// scheme for async SQLAlchemy
SCHEDULER_DATABASE_URL=postgresql+asyncpg://scheduler:scheduler@localhost:5432/scheduler_db

# ── Auth (shared secret — same value in every backend) ───────────────────────
AUTH_SECRET_KEY=dev-secret-key-change-in-production-abc123xyz
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list. In production, replace with real frontend origin(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
