# ── Service identity ────────────────────────────────────────────────────────
SERVICE_NAME=notification-backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database (PostgreSQL / asyncpg) ─────────────────────────────────────────
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notification_db

# ── Auth (shared HS256 secret — must match every other backend) ─────────────
AUTH_SECRET_KEY=dev-secret-key-change-in-production-abc123xyz
AUTH_ALGORITHM=HS256

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── SMTP (Mailpit locally; swap for real SMTP in production) ────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
# SMTP_USERNAME=          # optional; leave empty for Mailpit (no auth)
# SMTP_PASSWORD=          # optional

# ── ntfy push ───────────────────────────────────────────────────────────────
NTFY_BASE_URL=http://localhost:8088   # use http://ntfy inside Docker network

# ── WAHA WhatsApp ───────────────────────────────────────────────────────────
WAHA_BASE_URL=http://localhost:3000   # use http://waha:3000 inside Docker network
WAHA_SESSION=default

# ── Redis (DLQ — DB 2 keeps us away from auth DB 1 and agentic-chat DB 0) ──
REDIS_URL=redis://localhost:6100/2    # use redis://redis:6379/2 inside Docker network
