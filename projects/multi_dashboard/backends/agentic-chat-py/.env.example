# LLM Providers
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# Default LLM (provider: anthropic | openai)
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-4-6

# Redis
REDIS_URL=redis://localhost:6379

# MCP Servers (SSE transport)
# When running via docker-compose.yml these are overridden to use container names.
# Use localhost URLs only when running agentic-chat directly (outside Docker).
MCP_TOOLBOX_URL=http://localhost:8081/sse
MCP_NETWORK_URL=http://localhost:8082/sse
MCP_GRAFANA_URL=http://localhost:8083/sse
MCP_FLOWIQ_URL=http://localhost:8084/sse

# Job TTL in seconds (default 1 hour)
JOB_TTL_SECONDS=3600
